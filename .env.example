# Bu dosyayı ".env" adıyla kopyalayıp anahtarlarını yaz.

# ZORUNLU — Telegram'da @BotFather'a /newbot yaz, verdiği token'ı buraya yapıştır
TELEGRAM_BOT_TOKEN=

# İsteğe bağlı — botu sadece sen kullan (ElevenLabs kredin başkasına gitmesin).
# Kendi ID'ni öğrenmek için bota /start yaz. Birden fazla ise virgülle ayır.
ALLOWED_USER_IDS=

# İsteğe bağlı — https://www.deepl.com/pro-api  (Free plan: ayda 500.000 karakter)
DEEPL_API_KEY=

# İsteğe bağlı — https://elevenlabs.io -> Profile -> API Keys  (Free plan: ayda ~10.000 karakter)
# Yoksa kelimeler Tureng'in ses kaydıyla okunur, cümleler okunmaz.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# İngilizce öğretmeni (/sor) — ikisinden BİRİ yeterli:
# Gemini (ücretsiz, kart istemez): https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
# OpenAI (ücretli, önceden kredi yüklemek gerekir): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# İsteğe bağlı: modeli değiştir (varsayılan: gemini-3.8-flash / gpt-5-mini)
# AI_MODEL=
